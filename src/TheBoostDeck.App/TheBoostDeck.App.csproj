<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheBoostDeck.Core\TheBoostDeck.Core.csproj" />
    <ProjectReference Include="..\TheBoostDeck.Infrastructure\TheBoostDeck.Infrastructure.csproj" />
    <ProjectReference Include="..\TheBoostDeck.Skins\TheBoostDeck.Skins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TheBoostDeck</AssemblyName>
    <Version>0.1.1</Version>
    <Product>TheBoostDeck</Product>
    <Authors>TheBoostDeck contributors</Authors>
    <Description>Responsive secondary-display hardware monitoring for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\dashboard.html" LogicalName="TheBoostDeck.Web.dashboard.html" />
    <EmbeddedResource Include="Web\logo.png" LogicalName="TheBoostDeck.Web.logo.png" />
  </ItemGroup>

</Project>
